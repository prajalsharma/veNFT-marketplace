---
// End of every page: edit link, previous/next, then a compact docs footer.
// Ask Vezo is mounted here so it exists on every page, the home included.
import AskVezo from "./AskVezo.astro";
import Brand from "./Brand.astro";
import { getCollection } from "astro:content";
import { LINKS } from "../sections";

const { pagination, editUrl, entry } = Astro.locals.starlightRoute;
const { prev, next } = pagination;
const isHome = entry.id === "index" || entry.id === "";
const year = new Date().getFullYear();

// Each card carries the target page's own description, so the reader knows
// what is behind the link before following it.
const docs = await getCollection("docs");
const descOf = (href: string) => {
  const id = href.replace(/^\/|\/$/g, "");
  return docs.find((d) => d.id === id)?.data.description;
};
const prevDesc = prev ? descOf(prev.href) : undefined;
const nextDesc = next ? descOf(next.href) : undefined;
---

<footer class="vz-pf print:hidden">
  {!isHome && (
    <>
      {editUrl && (
        <a class="vz-edit" href={editUrl.toString()} target="_blank" rel="noopener noreferrer">
          <Brand name="github" size={14} /> Edit this page on GitHub
        </a>
      )}
      {(prev || next) && (
        <nav class="vz-pn" aria-label="Previous and next pages">
          {prev ? (
            <a href={prev.href} rel="prev" class="vz-pn-link">
              <span class="vz-pn-t"><svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><path d="M10 3 5 8l5 5" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>{prev.label}</span>
              {prevDesc && <span class="vz-pn-d">{prevDesc}</span>}
            </a>
          ) : <span />}
          {next && (
            <a href={next.href} rel="next" class="vz-pn-link vz-pn-next">
              <span class="vz-pn-t">{next.label}<svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><path d="m6 3 5 5-5 5" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
              {nextDesc && <span class="vz-pn-d">{nextDesc}</span>}
            </a>
          )}
        </nav>
      )}
    </>
  )}

  <div class="vz-df">
    <div class="vz-df-brand">
      <span class="vz-df-word">vezo</span>
      <span>The veNFT market on Mezo.</span>
    </div>
    <ul class="vz-df-links">
      <li><a href={LINKS.app} target="_blank" rel="noopener noreferrer">App</a></li>
      <li><a href={LINKS.analytics} target="_blank" rel="noopener noreferrer">Analytics</a></li>
      <li><a href="/resources/links/">Links &amp; addresses</a></li>
      <li><a href={LINKS.x} target="_blank" rel="noopener noreferrer" class="vz-df-icon"><Brand name="x" size={12} /> X</a></li>
      <li><a href={LINKS.github} target="_blank" rel="noopener noreferrer" class="vz-df-icon"><Brand name="github" size={14} /> GitHub</a></li>
    </ul>
    <p class="vz-df-legal">© {year} Vezo · Built on <a href={LINKS.mezo} target="_blank" rel="noopener noreferrer">Mezo</a></p>
  </div>
</footer>
<AskVezo />

<div class="vz-edge" aria-hidden="true"></div>
<button class="vz-expand" type="button" data-vz-sidebar-toggle aria-label="Show sidebar" title="Show sidebar">
  <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2.5"/><path d="M9 4v16"/></svg>
</button>

<script>
  // Collapsible sidebar (desktop). Collapsed, the page uses the full width;
  // moving the pointer to the left edge slides the sidebar back in over the
  // page, and it slides away again when the pointer leaves it.
  const root = document.documentElement;
  const pane = document.getElementById("starlight__sidebar");
  const edge = document.querySelector<HTMLElement>(".vz-edge");
  let hideTimer: number | undefined;

  const peek = (on: boolean) => {
    window.clearTimeout(hideTimer);
    if (on) root.dataset.vzPeek = "";
    else hideTimer = window.setTimeout(() => delete root.dataset.vzPeek, 220);
  };

  document.querySelectorAll<HTMLButtonElement>("[data-vz-sidebar-toggle]").forEach((btn) =>
    btn.addEventListener("click", () => {
      const collapse = root.dataset.vzSidebar !== "collapsed";
      if (collapse) root.dataset.vzSidebar = "collapsed";
      else delete root.dataset.vzSidebar;
      window.clearTimeout(hideTimer);
      delete root.dataset.vzPeek;
      try { localStorage.setItem("vz-sidebar", collapse ? "collapsed" : "open"); } catch {}
    }),
  );

  edge?.addEventListener("mouseenter", () => peek(true));
  edge?.addEventListener("mouseleave", () => peek(false));
  pane?.addEventListener("mouseenter", () => { if (root.dataset.vzSidebar === "collapsed") peek(true); });
  pane?.addEventListener("mouseleave", () => { if (root.dataset.vzSidebar === "collapsed") peek(false); });
  // Keyboard: tabbing into the hidden sidebar shows it
  pane?.addEventListener("focusin", () => { if (root.dataset.vzSidebar === "collapsed") peek(true); });
  pane?.addEventListener("focusout", (e) => {
    if (root.dataset.vzSidebar === "collapsed" && !pane.contains(e.relatedTarget as Node)) peek(false);
  });
</script>

<style>
  .vz-pf { margin-top: 4rem; display: grid; gap: 2rem; }
  .vz-edit { display: inline-flex; align-items: center; gap: 0.5rem; width: fit-content; font-size: 0.875rem; color: var(--sl-color-gray-3); text-decoration: none; }
  .vz-edit:hover { color: var(--sl-color-white); }
  .vz-pn { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; }
  .vz-pn-link {
    display: flex; flex-direction: column; gap: 0.4rem; padding: 1rem 1.15rem; border-radius: 10px; text-decoration: none;
    border: 1px solid var(--vz-hairline); background: var(--vz-card);
    transition: border-color 150ms ease, background-color 150ms ease;
  }
  .vz-pn-link:hover { border-color: var(--vz-hairline-strong); background: var(--vz-hover); }
  .vz-pn-link:focus-visible { outline: 2px solid var(--vz-red); outline-offset: 2px; }
  .vz-pn-next { text-align: end; align-items: flex-end; grid-column: 2; }
  .vz-pn-t { display: inline-flex; align-items: center; gap: 0.4rem; font-size: 0.9rem; font-weight: 600; color: var(--sl-color-white); }
  .vz-pn-d { font-size: 0.82rem; line-height: 1.5; color: var(--sl-color-gray-3); }
  .vz-df {
    margin-top: 2rem; padding-top: 1.75rem; border-top: 1px solid var(--vz-hairline);
    display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 1rem 2rem;
    font-size: 0.85rem; color: var(--sl-color-gray-3);
  }
  .vz-df-brand { display: flex; align-items: baseline; gap: 0.6rem; }
  .vz-df-word { font-weight: 800; font-size: 1.1rem; letter-spacing: -0.05em; color: var(--sl-color-white); }
  .vz-df-links { display: flex; flex-wrap: wrap; gap: 0.4rem 1.25rem; list-style: none; padding: 0; margin: 0; }
  .vz-df-links li { margin: 0; }
  .vz-df a { color: var(--sl-color-gray-2); text-decoration: none; }
  .vz-df a:hover { color: var(--sl-color-white); }
  .vz-df-icon { display: inline-flex; align-items: center; gap: 0.35rem; }
  .vz-df-legal { margin: 0; width: 100%; }
  @media (max-width: 40rem) {
    .vz-pn { grid-template-columns: 1fr; }
    .vz-pn-next { grid-column: 1; }
  }
</style>
