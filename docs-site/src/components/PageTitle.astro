---
// Title block: where you are (section / group), what the page is, and the
// page's own one-line description as a lead.
const PAGE_TITLE_ID = "_top"; // Starlight's skip-link target
import { SECTIONS } from "../sections";

const { entry } = Astro.locals.starlightRoute;
const { section, group } = Astro.locals.vezo ?? { section: null, group: null };
const sec = SECTIONS.find((s) => s.id === section);
const showGroup = group && sec && sec.groups.length > 1;
---

<div class="vz-pt">
  {sec && (
    <nav class="vz-crumbs" aria-label="Breadcrumb">
      <a href={sec.href}>{sec.label}</a>
      {showGroup && (<><span aria-hidden="true">/</span><span>{group}</span></>)}
    </nav>
  )}
  <h1 id={PAGE_TITLE_ID}>{entry.data.title}</h1>
  {entry.data.description && <p class="vz-lead">{entry.data.description}</p>}
</div>

<style>
  .vz-pt { padding-top: 0.5rem; }
  .vz-crumbs { display: flex; gap: 0.5rem; align-items: center; font-size: 0.85rem; font-weight: 500; color: var(--sl-color-gray-3); margin-bottom: 0.9rem; }
  .vz-crumbs a { color: var(--sl-color-gray-2); text-decoration: none; }
  .vz-crumbs a:hover { color: var(--sl-color-white); }
  h1 { font-size: clamp(2rem, 1.4rem + 1.6vw, 2.6rem); font-weight: 700; letter-spacing: -0.035em; line-height: 1.1; color: var(--sl-color-white); margin: 0; }
  .vz-lead { margin-top: 0.9rem; font-size: 1.15rem; line-height: 1.6; color: var(--sl-color-gray-2); max-width: 62ch; }
</style>
