---
// Title block: the page's group as a small label, the title, and the
// page's one-line description.
const PAGE_TITLE_ID = "_top"; // Starlight's skip-link target
const { entry } = Astro.locals.starlightRoute;
const group = Astro.locals.vezo?.group;
---

<div class="vz-pt">
  {group && <p class="vz-eyebrow">{group}</p>}
  <h1 id={PAGE_TITLE_ID}>{entry.data.title}</h1>
  {entry.data.description && <p class="vz-lead">{entry.data.description}</p>}
</div>

<style>
  .vz-pt { padding-top: 0.25rem; }
  .vz-eyebrow {
    margin: 0 0 0.85rem; font-family: var(--sl-font-mono); font-size: 0.72rem; font-weight: 500;
    letter-spacing: 0.12em; text-transform: uppercase; color: var(--vz-red);
  }
  h1 { font-size: clamp(2rem, 1.5rem + 1.4vw, 2.6rem); font-weight: 650; letter-spacing: -0.03em; line-height: 1.1; color: var(--sl-color-white); margin: 0; }
  .vz-lead { margin-top: 0.85rem; font-size: 1.05rem; line-height: 1.6; color: var(--sl-color-gray-3); max-width: 62ch; }
</style>
