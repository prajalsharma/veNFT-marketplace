---
// Top bar: the product's own navigation, with "Docs" marked as the current
// place. Search and the page tree live in the sidebar below it.
import SiteTitle from "virtual:starlight/components/SiteTitle";
import ThemeSelect from "virtual:starlight/components/ThemeSelect";
import SocialLinks from "./SocialLinks.astro";
import { LINKS } from "../sections";

const NAV = [
  { label: "Marketplace", href: LINKS.market },
  { label: "Analytics", href: LINKS.analytics },
  { label: "Support", href: LINKS.support },
];
---

<div class="vz-header">
  <SiteTitle />
  <nav class="vz-nav" aria-label="Vezo">
    {NAV.map((n) => <a href={n.href} target="_blank" rel="noopener noreferrer">{n.label}</a>)}
    <a href="/" aria-current="page">Docs</a>
  </nav>
  <div class="vz-right print:hidden">
    <div class="vz-icons">
      <SocialLinks />
      <ThemeSelect />
    </div>
    <a class="vz-app" href={LINKS.app} target="_blank" rel="noopener noreferrer">Open app</a>
  </div>
</div>

<style>
  .vz-header { display: flex; align-items: center; gap: 2.25rem; height: 100%; }
  .vz-nav { display: none; align-items: stretch; height: 100%; gap: 1.6rem; }
  .vz-nav a {
    position: relative; display: inline-flex; align-items: center;
    font-size: 0.9rem; font-weight: 500; text-decoration: none;
    color: var(--sl-color-gray-3); transition: color 150ms ease;
  }
  .vz-nav a:hover { color: var(--sl-color-white); }
  .vz-nav a[aria-current="page"] { color: var(--sl-color-white); font-weight: 600; }
  .vz-nav a[aria-current="page"]::after {
    content: ""; position: absolute; left: 0; right: 0; bottom: -1px; height: 2px; background: var(--vz-red);
  }
  .vz-nav a:focus-visible { outline: 2px solid var(--vz-red); outline-offset: 2px; border-radius: 4px; }
  .vz-right { margin-inline-start: auto; display: flex; align-items: center; gap: 0.75rem; }
  .vz-icons { display: none; align-items: center; gap: 0.25rem; }
  .vz-app {
    display: inline-flex; align-items: center; height: 2.35rem; padding: 0 1rem;
    border-radius: 8px; font-size: 0.875rem; font-weight: 600; text-decoration: none;
    color: var(--sl-color-white); border: 1px solid var(--vz-hairline-strong);
    transition: background-color 150ms ease, border-color 150ms ease;
  }
  .vz-app:hover { background: var(--vz-hover); border-color: var(--sl-color-gray-4); }
  .vz-app:focus-visible { outline: 2px solid var(--vz-red); outline-offset: 2px; }
  @media (min-width: 50rem) { .vz-nav, .vz-icons { display: flex; } }
</style>
