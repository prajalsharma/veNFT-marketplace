---
// The app's wordmark, as on vezo.exchange.
import logo from "../assets/vezo-logo.svg";
---
<a href="/" class="vz-title" aria-label="Vezo Docs home">
  <img src={logo.src} width="26" height="19" alt="" />
  <span class="vz-word">vezo</span>
</a>

<style>
  .vz-title { display: inline-flex; align-items: center; gap: 0.5rem; text-decoration: none; color: var(--sl-color-white); border-radius: 6px; }
  .vz-title img { height: 19px; width: auto; }
  .vz-word { font-weight: 800; font-size: 1.3rem; letter-spacing: -0.05em; line-height: 1; }
  .vz-title:focus-visible { outline: 2px solid var(--vz-red); outline-offset: 4px; }
</style>
